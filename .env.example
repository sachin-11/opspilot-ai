# OpsPilot AI - local development configuration.
# Copy to `.env` (scripts/bootstrap.ps1 does this for you). `.env` is git-ignored.
# The values below are throwaway local defaults, NOT real credentials.
# Inside Docker Compose, hosts are overridden to service names (postgres, redis).
# Keep comments on their own lines: values are parsed by Compose and by scripts.

# --- Application ---
# development | test | staging | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
API_HOST=0.0.0.0
# Port inside the container / for local uvicorn
API_PORT=8000
DEPENDENCY_TIMEOUT_SECONDS=2

# Comma-separated browser origins allowed to call the API. No wildcard outside development.
CORS_ORIGINS=http://localhost:3300
# Comma-separated CIDRs of reverse proxies / load balancers whose X-Forwarded-For is believed.
# Leave empty unless the API runs behind such a proxy: an empty value ignores the header, so
# callers cannot choose their own IP for rate limits and audit. Example: 10.0.0.0/8
TRUSTED_PROXY_CIDRS=

# --- Frontend ---
# URL the BROWSER uses to reach the API (baked into the web build).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8300

# --- PostgreSQL (pgvector) ---
POSTGRES_DB=opspilot
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=change-me-local-only
# Host-side tools use 127.0.0.1 (Compose publishes on IPv4 loopback only); Compose overrides the host with `postgres`.
POSTGRES_HOST=127.0.0.1
# Host-side port (matches POSTGRES_HOST_PORT); Compose services use 5432 internally.
POSTGRES_PORT=5450

# --- Redis ---
# Host-side URL; Compose overrides with redis://redis:6379/0
REDIS_URL=redis://127.0.0.1:6390/0

# --- Module 2 investigation engine ---
# "fake" is deterministic, credential-free, and is the supported local/CI provider.
AI_PRIMARY_PROVIDER=fake
AI_PRIMARY_MODEL=deterministic-v1
# Required only when AI_PRIMARY_PROVIDER is not fake.
AI_PRIMARY_API_KEY=
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=
AI_FALLBACK_API_KEY=
AI_PROVIDER_TIMEOUT_SECONDS=30
AI_PROVIDER_RETRIES=2
AI_MAX_RUNTIME_SECONDS=300
AI_MAX_LLM_CALLS=8
AI_MAX_TOOL_CALLS=20
AI_MAX_RETRIES_PER_NODE=1
AI_MAX_EVIDENCE_ITEMS=50
AI_MAX_TOOL_OUTPUT_BYTES=65536
AI_MAX_INPUT_TOKENS=50000
AI_MAX_OUTPUT_TOKENS=10000
AI_MAX_COST_USD=2.0
AI_MAX_REVISIONS=2
# Configured rates per one million tokens. Remove both variables to mark cost unavailable.
AI_INPUT_PRICE_PER_MILLION=0
AI_OUTPUT_PRICE_PER_MILLION=0
AI_AUTO_TRIGGER_ENABLED=false
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGGRAPH_STRICT_MSGPACK=true

# --- Module 3 operational knowledge ---
KNOWLEDGE_STORAGE_BACKEND=local
KNOWLEDGE_STORAGE_ROOT=./.data/knowledge
KNOWLEDGE_MAX_FILE_BYTES=5242880
KNOWLEDGE_MAX_PDF_PAGES=100
KNOWLEDGE_MAX_EXTRACTED_CHARS=2000000
KNOWLEDGE_CHUNK_TARGET_TOKENS=300
KNOWLEDGE_CHUNK_OVERLAP_TOKENS=40
KNOWLEDGE_CHUNK_MIN_TOKENS=20
KNOWLEDGE_CHUNK_MAX_TOKENS=500
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=hash-bow-v1
EMBEDDING_API_KEY=
# Fixed by migration 0004. Changing this requires an explicit schema migration and reindex.
EMBEDDING_DIMENSIONS=64
EMBEDDING_BATCH_SIZE=32
EMBEDDING_RETRIES=2
EMBEDDING_MAX_TOKENS_PER_JOB=200000
KNOWLEDGE_MAX_QUERY_LENGTH=1000
KNOWLEDGE_MAX_CANDIDATES=50
KNOWLEDGE_MAX_TOP_K=20
KNOWLEDGE_MIN_RELEVANCE=0.01
KNOWLEDGE_MIN_VECTOR_RELEVANCE=0.30
KNOWLEDGE_MIN_RERANK_RELEVANCE=0.10
RERANK_PROVIDER=fake
RERANK_MODEL=token-overlap-v1
RERANK_API_KEY=
RERANK_CANDIDATE_LIMIT=20
KNOWLEDGE_EXPERIMENTAL_QUERY_ENHANCEMENT=false
KNOWLEDGE_ENHANCEMENT_TIMEOUT_SECONDS=10
KNOWLEDGE_ENHANCEMENT_MAX_OUTPUT_TOKENS=300
KNOWLEDGE_ENHANCEMENT_MAX_COST_USD=0.01

# --- Host port mappings for Docker Compose (change if these are occupied) ---
WEB_HOST_PORT=3300
API_HOST_PORT=8300
POSTGRES_HOST_PORT=5450
REDIS_HOST_PORT=6390

# --- Module 4: read-only GitHub integration ---------------------------------------------
# "fixture" runs against committed synthetic repositories (no GitHub credentials, no network).
# Use "github" with a GitHub App that has ONLY read permissions: Contents, Metadata,
# Pull requests, Deployments. Never commit the private key; prefer the *_FILE variant.
GITHUB_PROVIDER=fixture
# Demo only: shift fixture timestamps so the planted regression is ~1h before now.
GITHUB_FIXTURE_REBASE_TO_NOW=false
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_FILE=
# Throwaway local value (min 16 chars). Set a long random secret in the GitHub App settings.
GITHUB_WEBHOOK_SECRET=local-dev-webhook-secret-change-me
GITHUB_API_BASE_URL=https://api.github.com
# Optional comma-separated allow-list of installation IDs this deployment may connect.
GITHUB_ALLOWED_INSTALLATION_IDS=
GITHUB_WEBHOOK_MAX_BYTES=1048576
REPO_MAX_FILES=2000
REPO_MAX_FILE_BYTES=262144
REPO_MAX_TOTAL_BYTES=20971520
REPO_MAX_CHUNKS=5000
REPO_INDEX_TIMEOUT_SECONDS=300
REPO_CHUNK_MAX_LINES=80
REPO_CHUNK_OVERLAP_LINES=5
REPO_MAX_PARSE_FAILURE_RATIO=0.5
REPO_MAX_COMMITS_PER_SYNC=100
REPO_CORRELATION_LOOKBACK_HOURS=72

# --- Module 5: observability event pipeline ---------------------------------------------
# Kafka-compatible broker (Redpanda in Compose). Containers use broker:9092; host-run tools use
# 127.0.0.1:${KAFKA_HOST_PORT}.
EVENT_BUS_BACKEND=kafka
KAFKA_HOST_PORT=19092
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
KAFKA_TOPIC_PREFIX=opspilot.observability
KAFKA_PARTITIONS=3
# Fernet key that encrypts webhook secrets at rest. Generate your own:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Throwaway local value; never reuse it outside local development.
OBS_SECRET_ENCRYPTION_KEY=mzn9nB8mYQ4Qd1yq0Z3sT0w6mYJm5J7B7xk3T4p8o9U=
OBS_WEBHOOK_MAX_BYTES=262144
OBS_WEBHOOK_REPLAY_WINDOW_SECONDS=300
OBS_WORKSPACE_RATE_PER_SECOND=200
OBS_SOURCE_RATE_PER_SECOND=100
OBS_LAG_THRESHOLD=5000
OBS_DEAD_LETTER_RATE_THRESHOLD=50
OBS_RETRY_MAX_ATTEMPTS=5
OBS_RETRY_MAX_AGE_SECONDS=900
OBS_RETRY_BASE_DELAY_SECONDS=0.5
OBS_DEDUP_WINDOW_SECONDS=300

# --- Module 6: remediation (patch proposals, sandbox verification, fix pull requests) ----
# docker = hardened ephemeral containers (build scripts/build-sandbox.ps1); fake executes nothing
# and is refused when APP_ENV=production.
REMEDIATION_SANDBOX_PROVIDER=docker
REMEDIATION_SANDBOX_IMAGE=opspilot-sandbox:latest
REMEDIATION_SANDBOX_CPU=1.0
REMEDIATION_SANDBOX_MEMORY_MB=512
REMEDIATION_SANDBOX_DISK_MB=256
REMEDIATION_SANDBOX_PIDS=128
REMEDIATION_SANDBOX_TIMEOUT_SECONDS=120
REMEDIATION_SANDBOX_MAX_ATTEMPTS=3
REMEDIATION_MAX_FILES=5
REMEDIATION_MAX_ADDED_LINES=120
REMEDIATION_MAX_DELETED_LINES=80
REMEDIATION_MAX_PATCH_BYTES=32768
REMEDIATION_MAX_REVISIONS=3
REMEDIATION_MAX_REPAIR_ATTEMPTS=2
REMEDIATION_APPROVAL_TTL_SECONDS=3600
# GitHub write access is OFF by default. To enable it for a repository, set the flag to true AND
# list "<workspace_uuid>:<owner>/<repo>" entries (comma separated). Writes create only a fix branch,
# one commit, and a pull request. Nothing is ever merged or deployed.
REMEDIATION_WRITE_PROVIDER=fixture
REMEDIATION_GITHUB_WRITE_ENABLED=false
REMEDIATION_WRITE_ENABLED_REPOSITORIES=
REMEDIATION_BRANCH_PREFIX=opspilot/fix-
# Sandbox-capable worker (host process, see scripts/remediation-worker.ps1): WORKER_QUEUES=remediation

# --- Module 7: authentication, RBAC, API keys ------------------------------------------
# local = deterministic development identity provider (refused outside development/test).
# oidc  = production: an OIDC provider such as AWS Cognito.
AUTH_PROVIDER=local
# oidc only. Cognito issuer: https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
AUTH_OIDC_ISSUER=
# oidc only. The Cognito app client ID (matched against the access token's client_id / aud claim).
AUTH_OIDC_AUDIENCE=
AUTH_OIDC_TOKEN_USE=access
# oidc only, optional. Needed for providers without <issuer>/.well-known/jwks.json (Keycloak, Auth0, Okta).
AUTH_OIDC_JWKS_URL=
# Local provider only. Throwaway values; never reuse them.
AUTH_LOCAL_SIGNING_KEY=local-dev-only-signing-key-do-not-use-elsewhere
# HMAC key for audit-log integrity. REQUIRED to be a strong secret outside development.
AUTH_AUDIT_KEY=local-dev-only-audit-integrity-key-0123456789
AUTH_RATE_LIMIT_ENABLED=true
# Web (server-side only). Seals the session cookie; at least 32 random characters.
SESSION_SECRET=local-dev-session-secret-change-me-0123456789abcdef
AUTH_MODE=local
APP_BASE_URL=http://localhost:3300
OIDC_CLIENT_ID=opspilot-web
OIDC_AUTHORIZATION_URL=http://localhost:8300/api/v1/auth/local/authorize
OIDC_TOKEN_URL=http://api:8000/api/v1/auth/local/token
OIDC_ISSUER=
OIDC_JWKS_URL=
# Optional local OIDC provider (compose profile "idp"). Throwaway local value, NOT a real credential.
KEYCLOAK_ADMIN_PASSWORD=change-me-local-only
KEYCLOAK_HOST_PORT=8180
